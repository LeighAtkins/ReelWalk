# AWS-backed development.
# Copy this to .env.aws after creating the Terraform resources, then run:
# docker compose -f docker-compose.yml -f docker-compose.aws-storage.yml --env-file .env.aws up --build

DATABASE_URL=postgresql://reelwalk:reelwalk@postgres:5432/reelwalk
REDIS_URL=redis://redis:6379/0

# Native AWS S3: leave endpoint and credentials empty to use the AWS SDK
# default credential chain, including AWS_PROFILE locally or task roles on ECS.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=reelwalk-media-dev
S3_FORCE_PATH_STYLE=false
CLOUDFRONT_BASE_URL=https://REPLACE_WITH_CLOUDFRONT_DOMAIN

API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=/api
DEV_USER_ID=dev-photographer

RENDER_PACKAGE_DIR=/workspace/packages/render
WORKSPACE_DIR=/workspace
WORKER_POLL_SECONDS=2
