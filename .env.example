# Shared local development
DATABASE_URL=postgresql://reelwalk:reelwalk@postgres:5432/reelwalk
REDIS_URL=redis://redis:6379/0

# S3-compatible storage. In local dev this is MinIO.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=reelwalk-dev
S3_FORCE_PATH_STYLE=true
CLOUDFRONT_BASE_URL=/media/reelwalk-dev

# API / web
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=/api
DEV_USER_ID=dev-photographer

# Worker / render
RENDER_PACKAGE_DIR=/workspace/packages/render
WORKSPACE_DIR=/workspace
WORKER_POLL_SECONDS=2
