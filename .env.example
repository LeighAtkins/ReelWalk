# docker-compose.yml already sets everything the containers need.
# Copy to .env only to override a default, or to run apps on the host with
# `pnpm dev:web` / `pnpm --filter @reelwalk/worker dev` against the compose services.

DATABASE_URL=postgresql://reelwalk:reelwalk@localhost:5432/reelwalk

# Eight-second Veo Fast clips, via Vertex AI (Google Cloud trial credit).
# Keep the credential server-side. In production it lives in encrypted SSM.
AI_VIDEO_ENABLED=false
AI_VIDEO_BUDGET_CENTS=24000
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_WORKLOAD_IDENTITY_AUDIENCE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Gemini Omni Flash (ADR 0105): 360p drafts first, 1080p once the reel is confirmed. The web needs only the switch;
# the worker calls the Gemini API with the key (Vertex offers the model only on provisioned throughput).
AI_OMNI_ENABLED=false
GEMINI_API_KEY=
# One-off purchase of 10 AI credits: A$19 GST included (STRIPE_PRICE_AI_TOP_UP) and, for visitors
# outside Australia, US$12 plus tax (STRIPE_PRICE_AI_TOP_UP_USD; unset hides the button for them).
STRIPE_PRICE_AI_TOP_UP=
STRIPE_PRICE_AI_TOP_UP_USD=

# To point the Compose web/worker at the real AWS bucket and queue instead,
# see docker-compose.aws.yml and infra/terraform/README.md (.env.aws).

# S3-compatible storage. In local dev this is MinIO.
S3_ENDPOINT_URL=http://localhost:9000
# Address the browser uses for presigned upload/download URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=reelwalk-dev
S3_FORCE_PATH_STYLE=true
# Set to an https:// CloudFront domain to serve finished videos from it.
CLOUDFRONT_BASE_URL=

# SQS. In local dev this is ElasticMQ.
AWS_REGION=us-east-1
SQS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/render-jobs
SQS_DLQ_URL=http://localhost:9324/000000000000/render-jobs-dlq

# Accounts. The login page offers the seeded demo studio when DEMO_PASSWORD is
# set; leave it unset on a public deployment. Cookies are marked secure over
# HTTPS (APP_URL) or when AUTH_SECURE_COOKIES=true.
DEMO_PASSWORD=reelwalk-demo
# Public address of the web app, for share links and OAuth callbacks. Unset,
# links use the address the browser came in on.
APP_URL=
AUTH_SECURE_COOKIES=

# Stripe billing (apps/web/lib/stripe.ts). Leave empty for plans without upgrade
# buttons. Price ids match packages/core/src/plans.ts, in Australian dollars with
# GST included: Agent A$39/A$390, Studio (stored as OFFICE) A$99/A$990. Yearly ids
# are optional. The AI top-up (10 credits, A$19) is STRIPE_PRICE_AI_TOP_UP.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AGENT_MONTHLY=
STRIPE_PRICE_AGENT_YEARLY=
STRIPE_PRICE_OFFICE_MONTHLY=
STRIPE_PRICE_OFFICE_YEARLY=
# Visitors outside Australia pay in US dollars, plus applicable tax (ADR 0085): Agent US$29/US$290,
# Studio US$79/US$790. Until both monthly ids are set everyone sees and pays the A$ prices.
STRIPE_PRICE_AGENT_MONTHLY_USD=
STRIPE_PRICE_AGENT_YEARLY_USD=
STRIPE_PRICE_OFFICE_MONTHLY_USD=
STRIPE_PRICE_OFFICE_YEARLY_USD=
# Optional: the Stripe product ids of the Agent and Studio plans. A subscription
# bought before the switch to AUD still carries its old USD price id; with these
# set it keeps resolving to its plan through the price's product (the AUD prices
# are also recognised by their lookup keys agent_monthly_aud, agent_yearly_aud,
# office_monthly_aud, office_yearly_aud).
STRIPE_PRODUCT_AGENT=
STRIPE_PRODUCT_OFFICE=

# Landing page sample reels: public URLs of finished exports, comma separated,
# with optional poster images in the same order. Empty shows a placeholder frame.
SAMPLE_REEL_URL=
SAMPLE_REEL_POSTER_URL=
# Optional, same order (ADR 0085): what each sample shows ("From 9 phone clips,Cut to the beat"),
# and an image of the raw clips it was cut from, offered as "Your clips" (leave an entry empty for none).
SAMPLE_REEL_LABELS=
SAMPLE_REEL_RAW_URLS=

# Free stock footage search in the restaurant reel builder (pixabay.com/api/docs).
PIXABAY_API_KEY=

# One-tap posting to Instagram: a Meta app with Instagram content publishing.
# The callback is <APP_URL>/api/instagram/connect -> /api/instagram/callback.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration id (app dashboard > Facebook Login
# for Business > Configurations). Leave empty for a classic Facebook Login app.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0

# Asking for a change in words (ADR 0020): an OpenAI key turns it on. The
# model defaults to gpt-6-luna; gpt-6.1-sol is the step up. With no key,
# DEV_FAKE_AI=true answers from a few rules so the screens still work.
# Direct Anthropic API: eligible usage draws from Claude Console credits.
# Explicit provider selection fails closed if its key is missing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optional explicit rollback: AI_PROVIDER=openai
# AI_PROVIDER=vertex bills Claude through Google Cloud instead (ADR 0072): no key;
# needs GOOGLE_CLOUD_PROJECT above plus the federation pair, or GOOGLE_APPLICATION_CREDENTIALS
# locally. VERTEX_CLAUDE_REGION defaults to global (list price); regions cost 10% more.
VERTEX_CLAUDE_REGION=
OPENAI_API_KEY=
OPENAI_MODEL=
DEV_FAKE_AI=
# Durable AI jobs (ADR 0049): 1 sends new Ask, autopilot and Director requests
# to the worker, which must be deployed first and needs the AI keys above too.
# AI_STEP_TIMEOUT_SECONDS bounds one attempt in the worker (default 600).
AI_JOBS_DURABLE=

# Worker. RENDER_MAX_ATTEMPTS must equal the queue's redrive maxReceiveCount.
RENDER_MAX_ATTEMPTS=3
RENDER_RETRY_BACKOFF_SECONDS=5
# How often a worker sends outbox messages the web app could not send itself.
OUTBOX_POLL_SECONDS=5
