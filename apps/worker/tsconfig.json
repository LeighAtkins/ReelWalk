{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // The AI steps are the web app's own module (src/ai-executor.ts, ADR 0049).
    "paths": { "@/*": ["../web/*"] }
  },
  "include": ["src", "tests", "scripts"]
}
