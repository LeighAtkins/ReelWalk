{
  "name": "reelwalk",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "pnpm --filter @reelwalk/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @reelwalk/db migrate:deploy",
    "db:seed": "pnpm --filter @reelwalk/db seed",
    "e2e": "pnpm --filter @reelwalk/e2e e2e",
    "test:render": "pnpm --filter @reelwalk/render test",
    "test:worker": "pnpm --filter @reelwalk/worker test",
    "library:import": "docker compose run --rm import-library"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "mysql2": "^3.22.0",
      "deepmerge-ts": "^8.0.0",
      "source-map-js": "^1.2.2",
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
