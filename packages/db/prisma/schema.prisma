generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaKind {
  VIDEO
  IMAGE
  AUDIO
}

enum RenderJobKind {
  TEMPLATE
  EDITOR
  // Export of a Reel from the mobile editor. payload holds a frozen copy of
  // the timeline and the object keys of every asset it uses.
  REEL
}

// Legal transitions live in @reelwalk/core (job-status.ts).
enum RenderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Workspace {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  createdAt  DateTime    @default(now())
  users      User[]
  properties Property[]
  reels      Reel[]
  media      MediaAsset[]
  renderJobs RenderJob[]
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  renderJobs  RenderJob[]
}

model Property {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  address     String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  media       MediaAsset[]
  renderJobs  RenderJob[]

  @@index([workspaceId, createdAt])
}

// The workspace's media library. Reels refer to assets by id from their timeline.
model MediaAsset {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Set for media uploaded through the older per-property flow.
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind        MediaKind
  objectKey   String      @unique
  // Small JPEG made in the browser at upload time, for the filmstrip and library.
  thumbKey    String?
  contentType String
  fileName    String
  sizeBytes   BigInt
  // Measured in the browser before upload. Null for photos (no duration) or when unreadable.
  durationMs  Int?
  width       Int?
  height      Int?
  createdAt   DateTime    @default(now())
  renderJobs  RenderJob[]

  @@index([workspaceId, createdAt])
  @@index([propertyId, createdAt])
}

model Reel {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  // The edit, validated by timelineSchema in @reelwalk/core.
  timeline    Json
  // Incremented on every save. A save carrying an older revision is rejected,
  // so two open tabs cannot silently overwrite each other.
  revision    Int         @default(0)
  // Instagram post text, kept with the reel so it can be copied when posting.
  caption     String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  renderJobs  RenderJob[]

  @@index([workspaceId, updatedAt])
}

model Template {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  description    String
  // Remotion composition id in packages/render.
  compositionId  String
  defaultCaption String
  brand          String
  createdAt      DateTime    @default(now())
  renderJobs     RenderJob[]
}

model RenderJob {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Set only for renders from the older per-property flow.
  propertyId   String?
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reelId       String?
  reel         Reel?           @relation(fields: [reelId], references: [id], onDelete: Cascade)
  mediaAssetId String?
  mediaAsset   MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  templateId   String?
  template     Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  kind         RenderJobKind   @default(TEMPLATE)
  status       RenderJobStatus @default(QUEUED)
  // 0-100, written by the worker while rendering.
  progress     Int             @default(0)
  // Delivery attempt within the current generation (SQS ApproximateReceiveCount).
  attempt      Int             @default(0)
  // Bumped on every manual retry; messages from older generations are ignored.
  generation   Int             @default(1)
  caption      String?
  // Timeline project JSON for EDITOR jobs.
  payload      Json?
  error        String?
  heartbeatAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  output       RenderOutput?

  @@index([workspaceId, createdAt])
  @@index([propertyId, createdAt])
  @@index([reelId, createdAt])
}

model RenderOutput {
  id          String    @id @default(cuid())
  // One output per job: a retried render replaces the row instead of adding one.
  jobId       String    @unique
  job         RenderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  objectKey   String
  contentType String
  sizeBytes   BigInt
  createdAt   DateTime  @default(now())
}
