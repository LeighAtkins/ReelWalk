generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaKind {
  VIDEO
  IMAGE
  AUDIO
}

enum RenderJobKind {
  TEMPLATE
  EDITOR
  // Transcode of an uploaded video into a small preview rendition for the
  // editor (mediaAssetId points at the upload; no reel, no output row needed).
  PREVIEW
  // Export of a Reel from the mobile editor. payload holds a frozen copy of
  // the timeline and the object keys of every asset it uses.
  REEL
}

// Legal transitions live in @reelwalk/core (job-status.ts).
enum Plan {
  FREE
  AGENT
  OFFICE
}

enum RenderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model Workspace {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  createdAt  DateTime    @default(now())
  users      User[]
  properties Property[]
  reels      Reel[]
  media      MediaAsset[]
  tours      Tour[]
  renderJobs RenderJob[]
  socialAccounts SocialAccount[]
  feedback   Feedback[]
  scheduledPosts ScheduledPost[]
  aiEdits    AiEdit[]
  briefs     ReelBrief[]
  aiJobs     AiJob[]
  commentTriggers CommentTrigger[]
  aiCreditGrants AiCreditGrant[]
  aiGenerations AiGeneration[]
  workflowRuns WorkflowRun[]
  presenters Presenter[]
  variantGroups VariantGroup[]

  // Set by the Stripe webhook from the subscription (plans in @reelwalk/core).
  plan                 Plan      @default(FREE)
  // A plan given by hand (testers), good until compedUntil. A paid plan wins.
  compedPlan           Plan?
  compedUntil          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  planRenewsAt         DateTime?
  aiPaidThrough        DateTime?
  aiPaidPlan           Plan @default(FREE)
  aiPaidPeriodStart    DateTime?
  aiLastInvoiceCreated Int @default(0)
}

model AiCreditGrant {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      String @unique
  kind        String
  amount      Int
  remaining   Int
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  generations AiGeneration[]

  @@index([workspaceId, expiresAt])
}

model AiGeneration {
  id            String @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  requestId     String
  grantId       String
  grant         AiCreditGrant @relation(fields: [grantId], references: [id])
  prompt        String
  referenceKey  String?
  referenceType String?
  shot          Json?
  frameSources  Json?
  model         String
  // A submission with an unknown outcome is never repeated automatically.
  status        String @default("QUEUED")
  operationName String?
  assetId       String? @unique
  costCents     Int @default(80)
  // Requested clip length (4 or 8 s) and credits debited at 4 s per credit.
  // Defaults describe rows created before 4-second credits: 8 s, 2 credits after the doubling.
  durationSeconds Int @default(8)
  credits       Int @default(2)
  // [{ grantId, credits }] when the debit spans grants; null means all of it came from grantId.
  grantDebits   Json?
  error         String?
  leaseToken    String?
  leaseUntil    DateTime?
  nextPollAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  finishedAt    DateTime?
  // Presenter identity (ADR 0056). The kit the composed stills were made from, if any.
  presenterId   String?
  // 0 = composed from the kit or real footage; n = from a generated take n hops from a real reference. Null when nothing was composed.
  referenceDepth Int?
  // The identity gate's confidence that the composed face is the kit's person (lowest across composed ends), 0..1.
  identityScore Float?
  // Every gate verdict: [{ end, attempt, samePerson, confidence, faceHeightPx }].
  identityChecks Json?
  // A machine-readable reason for a failure, e.g. "identity_rejected".
  failureCode   String?
  // Set under the lease fence just before the paid provider call (ADR 0056): a stale row with it set
  // may have been submitted, so it is never refunded automatically (UNRESOLVED), only one without it.
  submitStartedAt DateTime?

  @@unique([workspaceId, requestId])
  @@index([status, nextPollAt])
  @@index([workspaceId, createdAt])
}

// A workspace's presenter (ADR 0056): the real stills every composed AI take is made from,
// so takes never use another generated take as the face reference.
model Presenter {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  // Head-and-shoulders still (face ideally 400 px tall or more) and a clean full-length still; owned uploads.
  portraitAssetId String
  fullBodyAssetId String
  // The worker's 768x768 PNG of the face, cut from the portrait. Null until it is made.
  faceCropKey     String?
  // Face height in the portrait, measured when the crop was made.
  faceHeightPx    Int?
  faceCropError   String?
  // Attempts at the crop, so a broken still is not retried forever.
  faceCropTries   Int       @default(0)
  leaseToken      String?
  leaseUntil      DateTime?
  voice           String?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, createdAt])
}

// Application-enforced lifetime ceiling in USD cents. Retain reservations
// after ambiguous provider failures rather than trusting delayed alerts.
model AiSpendBudget {
  id            String @id
  reservedCents Int @default(0)
}

// Stripe event ids already handled, so a repeated delivery changes nothing.
model BillingEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String
  // scrypt hash, "scrypt$<salt>$<hash>" (apps/web/lib/auth.ts). Null for accounts that cannot sign in.
  passwordHash String?
  // May open /admin/*. Set by hand (packages/db/scripts/set-admin.ts), never by the app.
  isAdmin     Boolean     @default(false)
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  renderJobs  RenderJob[]
  sessions    Session[]
  passwordResets PasswordReset[]
  feedback    Feedback[]
  aiEdits     AiEdit[]
  scheduledPosts ScheduledPost[]
  aiGenerations AiGeneration[]
}

// A "forgot your password" link. The email carries a random token; only its
// SHA-256 is stored. Good for an hour and for one use (apps/web/app/password-reset-actions.ts).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A note someone sent us from the app. Also emailed to the support address;
// the row stays if the account is later deleted, with the ids cleared.
model Feedback {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  message     String
  // Path of the screen the form was opened from, e.g. "/reels/abc/export".
  page        String?
  // The sender ticked "you may contact me about this".
  contactOk   Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

// A signed-in browser. The cookie carries a random token; only its SHA-256 is stored.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

// Sign-in, sign-up and password attempts counted per key ("login:email:...",
// "login:ip:...") in a fixed window (apps/web/lib/throttle.ts).
model AuthThrottle {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

enum ScheduledPostStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

// A finished export queued to go out as an Instagram Reel at publishAt (ADR
// 0017). The publisher (packages/db/src/scheduled-posts.ts) claims due rows
// with a compare-and-set on claimToken, so two web instances never work on
// the same post at once.
model ScheduledPost {
  id          String              @id @default(cuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  renderJobId String
  renderJob   RenderJob           @relation(fields: [renderJobId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // Copied from the reel when scheduled, so later edits do not change a queued post.
  caption     String
  // Instagram's thumb_offset: where the cover frame is taken from.
  coverMs     Int                 @default(700)
  // A sound from Instagram's own library (ADR 0018), sent as
  // audio_configuration when the container is created. All null: none.
  audioId     String?
  audioTitle  String?
  audioArtist String?
  // 0-100 each: the sound, and the reel's own soundtrack under it.
  audioVolume Int?
  videoVolume Int?
  // Sent as is_ai_generated: Instagram shows its "AI info" label on the post.
  aiGenerated Boolean @default(false)
  // UTC. The form converts from the viewer's time zone.
  publishAt   DateTime
  status      ScheduledPostStatus @default(SCHEDULED)
  // Failed tries so far (transient errors are retried up to three times).
  attempts    Int                 @default(0)
  // Why the last try failed, in words for the studio.
  error       String?
  // Set by each claim; every later write is conditional on it.
  claimToken  String?
  // A PUBLISHING post is not touched again before this time: the next
  // container check, a retry after a transient error, or, while an instance
  // holds it, the moment the claim counts as abandoned (15 minutes).
  nextCheckAt DateTime?
  // The Instagram media container, kept across ticks while Instagram processes the video.
  containerId String?
  containerAt DateTime?
  mediaId     String?
  permalink   String?
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, publishAt])
  @@index([status, nextCheckAt])
  @@index([workspaceId, publishAt])
  @@index([renderJobId])
}

// A connected publishing account, e.g. an Instagram professional account.
model SocialAccount {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider    String // "instagram"
  externalId  String
  username    String
  accessToken String
  expiresAt   DateTime?
  // Instagram API with Instagram Login (ADR 0026): private replies to
  // comments need a token from Instagram's own login, separate from the
  // Facebook Login token above that publishes. Null until connected.
  messagingToken     String?
  messagingUserId    String?
  messagingExpiresAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, provider])
}

// "Comment REEL and I'll send you the guide" (ADR 0026): a keyword in a
// comment on one of the workspace's recent posts gets one private reply
// (a DM) with message, and optionally a public reply under the comment.
model CommentTrigger {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Matched as a whole word, any case.
  keyword     String
  message     String
  publicReply String?
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  replies     CommentReply[]

  @@unique([workspaceId, keyword])
}

// One per answered comment: the unique commentId is what stops a second DM.
model CommentReply {
  id        String         @id @default(cuid())
  triggerId String
  trigger   CommentTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  commentId String         @unique
  mediaId   String
  username  String?
  text      String
  // SENDING while claimed, then SENT or FAILED.
  status    String         @default("SENDING")
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([triggerId, createdAt])
}

model Property {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  address     String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  media       MediaAsset[]
  renderJobs  RenderJob[]

  @@index([workspaceId, createdAt])
}

// The workspace's media library. Reels refer to assets by id from their timeline.
model MediaAsset {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Set for media uploaded through the older per-property flow.
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind        MediaKind
  objectKey   String      @unique
  // Small JPEG made in the browser at upload time, for the filmstrip and library.
  thumbKey    String?
  // 720p H.264 rendition made by a worker after upload, played in the editor
  // instead of the phone's original (which can be 4K at 20+ Mbit/s). Exports
  // still use objectKey.
  previewKey  String?
  contentType String
  fileName    String
  sizeBytes   BigInt
  // Measured in the browser before upload. Null for photos (no duration) or when unreadable.
  durationMs  Int?
  width       Int?
  height      Int?
  // Open-library media every workspace may use (the starter library). Owned by the demo workspace.
  shared      Boolean     @default(false)
  // Set for media imported from an open library, so the licence travels with the file.
  sourceUrl   String?
  license     String?
  attribution String?
  // Set when the shot belongs to a walkthrough of one home.
  tourId      String?
  tour        Tour?       @relation(fields: [tourId], references: [id], onDelete: SetNull)
  // Where on the tour's floor plan the shot was taken: { x, y, heading } (spotSchema in @reelwalk/core).
  spot        Json?
  // Room name, e.g. "kitchen".
  room        String?
  // For music: tempo and the time of the first beat, detected at upload or import.
  bpm          Float?
  beatOffsetMs Int?
  // For music: where its bars start and its intro/build/drop/outro (songMapSchema in @reelwalk/core, ADR 0059).
  songMap      Json?
  // Set when this is the workspace's private copy of an Instagram sound's
  // preview (ADR 0019): for editing against in the editor only. It is never
  // rendered into an export or published; Instagram attaches the sound itself.
  instagramAudioId String?
  instagramTitle   String?
  instagramArtist  String?
  // What a video says, with word timings, made by the worker after upload (transcriptSchema in @reelwalk/core).
  transcript  Json?
  createdAt   DateTime    @default(now())
  renderJobs  RenderJob[]

  // One copy per sound per workspace, so choosing it again reuses it.
  @@unique([workspaceId, instagramAudioId])
  @@index([workspaceId, createdAt])
  @@index([propertyId, createdAt])
  @@index([shared])
}

// A walkthrough of one home: its floor plan, and the shots located on it.
model Tour {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // Floor plan geometry (planSchema in @reelwalk/core).
  plan        Json
  sourceUrl   String?
  license     String?
  attribution String?
  createdAt   DateTime     @default(now())
  media       MediaAsset[]

  @@index([workspaceId])
}

model Reel {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  // The edit, validated by timelineSchema in @reelwalk/core.
  timeline    Json
  // Incremented on every save. A save carrying an older revision is rejected,
  // so two open tabs cannot silently overwrite each other.
  revision    Int         @default(0)
  // Instagram post text, kept with the reel so it can be copied when posting.
  caption     String      @default("")
  // Random token in the public link /r/<token>. Null until sharing is switched on.
  shareToken  String?     @unique
  // The owner lets ReelWalk repost the export on @reelwalking and the site
  // (ADR 0016). Off by default; withdrawn from the same checkbox.
  featureConsent   Boolean   @default(false)
  // Instagram handle to credit, without the "@".
  featureHandle    String?
  featureConsentAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  renderJobs  RenderJob[]
  aiEdits     AiEdit[]
  // Set when this reel is one of a set of variants (ADR 0063).
  variant     ReelVariant?
  // Sets of variants made from this reel.
  variantSets VariantGroup[] @relation("VariantSource")

  @@index([workspaceId, updatedAt])
}

// A set of variants made from one finished reel (ADR 0063): sibling reels
// that open differently and run 15 or 30 s, kept together so the studio can
// compare how each did once posted. The variants are ordinary reels that use
// the same media assets; nothing is copied.
model VariantGroup {
  id           String        @id @default(cuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // The reel the set was made from. Kept when that reel is deleted, so the set can still be compared.
  sourceReelId String?
  sourceReel   Reel?         @relation("VariantSource", fields: [sourceReelId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  variants     ReelVariant[]

  @@index([workspaceId, createdAt])
  @@index([sourceReelId])
}

// One reel's place in a set, and its Instagram numbers when they were last read.
model ReelVariant {
  reelId     String       @id
  reel       Reel         @relation(fields: [reelId], references: [id], onDelete: Cascade)
  groupId    String
  group      VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // "hero" | "presenter" | "title" (VARIANT_HOOKS in @reelwalk/core).
  hook       String
  // 15 or 30: the length asked for; the reel's own timeline has the exact one.
  lengthS    Int
  // From Instagram's insights for the post of this reel (ADR 0027); null until it is posted and read.
  views      Int?
  reach      Int?
  mediaId    String?
  // When the numbers were last read successfully.
  insightsAt DateTime?
  // When Instagram was last asked, whatever came of it: the ten-minute limit counts from here, so failures are not retried on every load.
  insightsCheckedAt DateTime?

  @@index([groupId])
}

// A change asked for in words (ADR 0020): the request, the model's answer
// and what was applied. Counted against the plan's monthly allowance, and
// kept so the answers can be read back to judge the model and its cost.
model AiEdit {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  reelId       String?
  reel         Reel?     @relation(fields: [reelId], references: [id], onDelete: SetNull)
  request      String
  // The model's one- or two-sentence reply to the studio.
  note         String
  // The operations as returned (aiEditPlanSchema), and the lines applyAiEditPlan reported.
  plan         Json
  applied      Json
  skipped      Json
  model        String
  inputTokens  Int       @default(0)
  cachedTokens Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// A long AI request (a whole-reel cut takes over a minute) run in the
// background: the browser starts it and checks back, so no proxy or phone
// connection has to stay open for the whole of it (ADR 0021).
model AiJob {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reelId      String?
  // "ask" or "autopilot".
  kind        String
  // RUNNING, DONE or FAILED.
  status      String    @default("RUNNING")
  // What the route would have answered: the timeline, the note, and so on.
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, createdAt])
}

// Durable AI workflows (ADR 0049). A run is what the studio asked for (one
// Ask, one autopilot polish, one Director review, or a whole Director
// "make it for me" run); its steps are the units the worker executes, each
// under a lease. Request identity (requestId + requestHash) belongs to the
// run and never changes; execution attempts belong to the step.
enum WorkflowStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  // A paid provider request may or may not have been submitted (the worker
  // died, or the connection broke after sending). Never retried automatically.
  UNRESOLVED
}

model WorkflowRun {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  reelId          String?
  // "ask", "autopilot", "director" (one review) or "director-run" (ADR 0037 loop).
  kind            String
  // The browser's id for this request and a hash of what it asked; the same
  // id with a different payload is refused, the same payload resumes.
  requestId       String
  requestHash     String
  status          WorkflowStatus @default(QUEUED)
  // Set by Stop. A queued step that has not reached the provider ends FAILED;
  // a step already submitted finishes and is kept, and no further round starts.
  cancelRequested Boolean        @default(false)
  // timelineGeneration() of the timeline the run started from, and of the
  // timeline the next step must start from (the last applied proposal).
  baselineGeneration String?
  expectedBaseline   String?
  // Explicit consent for spending credits without asking each time (director-run).
  approvedAt      DateTime?
  // Credit budget for the run, credits already committed to generations, and
  // credits held for a generation being started. Credits themselves are still
  // charged by the existing AI credit ledger; these only bound the run.
  budgetCredits   Int?
  spentCredits    Int            @default(0)
  reservedCredits Int            @default(0)
  // Director loop position: rounds done and the limit.
  round           Int            @default(0)
  maxRounds       Int?
  // Free-form view state for the sheet: the run's AiEdit id, the generation
  // being waited for, the last message.
  state           Json?
  result          Json?
  error           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  finishedAt      DateTime?
  steps           WorkflowStep[]

  @@unique([workspaceId, kind, requestId])
  @@index([workspaceId, reelId, createdAt])
}

model WorkflowStep {
  id          String         @id @default(cuid())
  runId       String
  run         WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  index       Int
  // "ask", "autopilot" or "director-review".
  kind        String
  // Each step has its own request identity too (a Director round's review id).
  requestId   String
  requestHash String
  status      WorkflowStatus @default(QUEUED)
  // Bumped when a person explicitly re-queues the step; stale messages carry the old one.
  generation  Int            @default(1)
  // The queue receive count of the claim that holds the lease.
  attempt     Int            @default(0)
  heartbeatAt DateTime?
  startedAt   DateTime?
  // Written under the lease immediately before a paid provider request. Once
  // set, the step is never executed again: a lost lease becomes UNRESOLVED.
  submittedAt DateTime?
  // timelineGeneration() of the timeline this step read.
  baselineGeneration String?
  // The validated input. Review frame images are removed once the step ends.
  payload     Json
  result      Json?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  finishedAt  DateTime?

  @@unique([runId, index])
  @@unique([runId, requestId])
  // The Director sheet's pending reviews, and the reaper's scan.
  @@index([kind, status])
  @@index([status, updatedAt])
}

// A saved way of cutting a reel (ADR 0020): the words a studio gives the
// model when it asks for a whole reel to be cut, kept to use again.
model ReelBrief {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  text        String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model Template {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  description    String
  // Remotion composition id in packages/render.
  compositionId  String
  defaultCaption String
  brand          String
  createdAt      DateTime    @default(now())
  renderJobs     RenderJob[]
}

model RenderJob {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Set only for renders from the older per-property flow.
  propertyId   String?
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reelId       String?
  reel         Reel?           @relation(fields: [reelId], references: [id], onDelete: Cascade)
  mediaAssetId String?
  mediaAsset   MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  templateId   String?
  template     Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  kind         RenderJobKind   @default(TEMPLATE)
  status       RenderJobStatus @default(QUEUED)
  // 0-100, written by the worker while rendering.
  progress     Int             @default(0)
  // Claims within the current generation: the worker increments it at each claim (ADR 0050).
  attempt      Int             @default(0)
  // Bumped on every manual retry; messages from older generations are ignored.
  generation   Int             @default(1)
  caption      String?
  // Timeline project JSON for EDITOR jobs.
  payload      Json?
  error        String?
  heartbeatAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  output       RenderOutput?
  scheduledPosts ScheduledPost[]

  @@index([workspaceId, createdAt])
  @@index([propertyId, createdAt])
  @@index([reelId, createdAt])
}

// Transactional outbox: a queue message that still has to be sent. The row is
// written in the same transaction as the job change it announces, and deleted
// once the queue has accepted the message (packages/db/src/outbox.ts).
model OutboxMessage {
  id          String   @id @default(cuid())
  // Which queue the body is for.
  topic       String
  body        String
  // Failed sends so far, and the reason for the last one.
  attempts    Int      @default(0)
  lastError   String?
  // Not sent before this time; pushed back after every failed send.
  availableAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([topic, availableAt])
}

model RenderOutput {
  id          String    @id @default(cuid())
  // One output per job: a retried render replaces the row instead of adding one.
  jobId       String    @unique
  job         RenderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  objectKey   String
  contentType String
  sizeBytes   BigInt
  createdAt   DateTime  @default(now())
}

// "Popular now" (ADR 0058): a song scored from a playlist snapshot (Σ
// ln(1 + followers) × position weight, plus the source's popularity), and the
// Instagram sound it was matched to, if any. Global, not per workspace: the
// popularity is public and business accounts share one library. Written only
// by the worker's music-chart job; the editor reads matched rows and never
// offers anything that is not one of them.
model MusicCandidate {
  id           String    @id @default(cuid())
  // "isrc:<ISRC>" or "ta:<title>|<first artist>", normalised (titleArtistKey in @reelwalk/core).
  key          String    @unique
  isrc         String?
  title        String
  artist       String
  score        Float
  // Mood ids (MUSIC_MOODS in @reelwalk/core) of the searches whose playlists it is in.
  moods        Json
  // [{ id, name, followers, position }], biggest following first.
  playlists    Json
  // Where the snapshot came from ("chartmetric 2026-10-21", "hand-curated").
  source       String
  // The Instagram sound it matched: a recording ("track") or a creator's cover ("cover").
  igAudioId    String?
  igAudioType  String?
  igTitle      String?
  igArtist     String?
  igDurationMs Int?
  igMatch      String?
  igConfidence Float?
  // Rank in Instagram's trending list for its type when the job last ran, or null.
  trendingRank Int?
  // Tempo of the sound, copied from any analysed copy of it (MediaAsset.bpm).
  bpm          Float?
  // When the snapshot was taken, and when the Instagram match was last checked.
  fetchedAt    DateTime
  matchedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([igAudioId])
  @@index([score])
}
