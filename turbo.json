{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["db:generate", "^db:generate"]
    },
    "@reelwalk/core#typecheck": {
      "dependsOn": ["@reelwalk/db#db:generate"]
    },
    "@reelwalk/core#test": {
      "dependsOn": ["@reelwalk/db#db:generate"],
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["db:generate", "^db:generate"],
      "env": ["DATABASE_URL"]
    }
  }
}
